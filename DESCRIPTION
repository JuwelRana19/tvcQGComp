Package: tvcQGComp
Type: Package
Title: Time-Varying Quantile G-Computation (tvcQGcomp)
Version: 0.0.0
Authors@R: c(
    person(given = "Juwel", family = "Rana",
           role = c("aut", "cre"),
           email = "juwelrana@saistbd.org"),
